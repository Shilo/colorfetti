+// The mask and count proof share this exact lookup: count metadata must not
+// introduce a second brightness/pattern conversion rule.
+function patternTones({ lo, hi }, opt, t) {
+  const shading = (opt.shading ?? 100) / 100;
+  return Float64Array.from({ length: 256 }, (_, l) => {
+    const tone = l <= t ? (t > lo ? (0.5 * (l - lo)) / (t - lo) : 0) : 0.5 + (0.5 * (l - t)) / (hi - t);
+    return shading ? Math.min(1, Math.max(0, 0.5 + (tone - 0.5) / shading)) : tone > 0.5 ? 1 : 0;
+  });
+}
+
+// Exact lower/upper role bounds from already prepared visible brightness bins.
+// No mask, source-pixel walk or analysis is created. Intermediate ordered tones
+// remain ambiguous because their role depends on the full-source coordinate.
+export function patternRoleBounds(img, style, set = null) {
+  if (!PATTERNS.includes(style)) return null;
+  const opt = typeof set === 'number' ? { threshold: set } : set ?? {};
+  const tones = patternTones(img, opt, opt.threshold ?? autoThreshold(img, style));
+  let lowCut = 1, highCut = 0;
+  if (style !== 'atkinson') {
+    const { cuts } = TILES[style](opt);
+    for (const cut of cuts) { lowCut = Math.min(lowCut, cut); highCut = Math.max(highCut, cut); }
+  }
+  let lower = 0, upper = 0;
+  for (let l = 0; l < 256; l++) {
+    if (!img.hist[l]) continue;
+    const tone = tones[l];
+    if (!Number.isFinite(tone)) return null;
+    if (style === 'atkinson') {
+      // With only exact endpoint tones every emitted error is zero, for all
+      // diffusion kernels. Any intermediate tone invalidates that proof.
+      if (tone !== 0 && tone !== 1) return null;
+      lower |= tone === 1 ? 2 : 1;
+      upper = lower;
+    } else {
+      const roles = tone <= lowCut ? 1 : tone > highCut ? 2 : 3;
+      upper |= roles;
+      if (roles !== 3) lower |= roles;
+    }
+  }
+  return { lower, upper };
+}
