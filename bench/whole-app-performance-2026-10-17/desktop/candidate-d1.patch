+        expect([...actual.used]).toEqual(Array.from({ length: 256 }, (_, i) => Number(expected.includes(i))));
+        if (alphaMode === 'keep') expect([...actual.alpha]).toEqual(sampled.map((pixel, i) => expected[i] === EMPTY_INDEX ? 0 : pixel[3]));
+        expect(await quantizeAsync(source, colors, 128, mw, mh, { metric, alphaMode })).toEqual(actual);
+      }
+    }
+  });
