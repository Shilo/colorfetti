+  it.each(['oklab', 'rgb'])('preserves source coordinates and alpha when either or both dimensions are unchanged using %s', async metric => {
+    const colors = ['#000000', '#777777', '#ffffff'];
+    for (const [w, h, mw, mh] of [[11, 7, 11, 7], [11, 7, 11, 3], [11, 7, 4, 7], [1, 7, 1, 7], [11, 1, 11, 1], [1, 7, 1, 3], [11, 1, 4, 1]]) {
+      const pixels = Array.from({ length: w * h }, (_, i) => [i * 19 % 256, i * 37 % 256, i * 53 % 256, [0, 1, 127, 128, 255][i % 5]]);
+      const source = image(pixels, w, h);
+      for (const alphaMode of ['cut', 'keep']) {
+        const sampled = Array.from({ length: mw * mh }, (_, i) => pixels[Math.floor((Math.floor(i / mw) + .5) * h / mh) * w + Math.floor((i % mw + .5) * w / mw)]);
